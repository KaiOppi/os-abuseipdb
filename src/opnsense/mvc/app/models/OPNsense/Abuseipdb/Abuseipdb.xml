<model>
    <mount>//OPNsense/Abuseipdb</mount>
    <description>AbuseIPDB plugin configuration</description>
    <version>0.1.5</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <api_key type="TextField">
                <Mask>/^[a-fA-F0-9]{80}$|^$/u</Mask>
                <ValidationMessage>Enter an 80-character AbuseIPDB API key (hex).</ValidationMessage>
                <default></default>
            </api_key>
        </general>
        <rules>
            <style type="OptionField">
                <Required>Y</Required>
                <Default>classic</Default>
                <OptionValues>
                    <classic>Classic — Firewall: Rules: WAN (legacy &lt;filter&gt;)</classic>
                    <automation>Automation — Firewall: Automation: Filter (new Rules tab)</automation>
                    <none>None — manage block rules myself</none>
                </OptionValues>
            </style>
            <manage type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </manage>
            <last_applied_style type="TextField">
                <Mask>/^(classic|automation|none|)$/u</Mask>
                <ValidationMessage>internal: previous rule style</ValidationMessage>
                <default></default>
            </last_applied_style>
        </rules>
        <blacklist>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <confidence_min type="IntegerField">
                <MinimumValue>25</MinimumValue>
                <MaximumValue>100</MaximumValue>
                <default>90</default>
                <Required>Y</Required>
            </confidence_min>
            <max_ips type="IntegerField">
                <MinimumValue>100</MinimumValue>
                <MaximumValue>500000</MaximumValue>
                <default>10000</default>
                <Required>Y</Required>
            </max_ips>
            <include_ipv6 type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </include_ipv6>
            <persist_days type="IntegerField">
                <MinimumValue>0</MinimumValue>
                <MaximumValue>365</MaximumValue>
                <default>0</default>
                <Required>Y</Required>
            </persist_days>
            <block_interfaces type="TextField">
                <default>wan</default>
                <Mask>/^[a-zA-Z0-9_,\s]*$/u</Mask>
                <ValidationMessage>Comma-separated list of interface identifiers (e.g. "wan,opt1").</ValidationMessage>
            </block_interfaces>
        </blacklist>
        <selfcare>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <ttl_hours type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>8760</MaximumValue>
                <default>72</default>
                <Required>Y</Required>
            </ttl_hours>
        </selfcare>
        <permaban>
            <enabled type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </enabled>
            <promote_threshold type="IntegerField">
                <MinimumValue>2</MinimumValue>
                <MaximumValue>50</MaximumValue>
                <default>3</default>
                <Required>Y</Required>
            </promote_threshold>
            <promote_window_days type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>365</MaximumValue>
                <default>14</default>
                <Required>Y</Required>
            </promote_window_days>
        </permaban>
        <reporter>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <min_hits type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>1000</MaximumValue>
                <default>3</default>
                <Required>Y</Required>
            </min_hits>
            <rate_limit_per_ip_min type="IntegerField">
                <MinimumValue>5</MinimumValue>
                <MaximumValue>1440</MaximumValue>
                <default>15</default>
                <Required>Y</Required>
            </rate_limit_per_ip_min>
            <daily_quota type="IntegerField">
                <MinimumValue>100</MinimumValue>
                <MaximumValue>100000</MaximumValue>
                <default>900</default>
                <Required>Y</Required>
            </daily_quota>
            <default_categories type="TextField">
                <Mask>/^[0-9,\s]*$/u</Mask>
                <ValidationMessage>Comma-separated AbuseIPDB category IDs.</ValidationMessage>
                <default>14,15</default>
                <Required>Y</Required>
            </default_categories>
            <comment_template type="TextField">
                <Mask>/^.{1,500}$/u</Mask>
                <ValidationMessage>1-500 chars. Placeholders {count}, {protos}, {ports}, {iface}, {src_ip}.</ValidationMessage>
                <default>Blocked by os-abuseipdb; {count} hits, proto={protos}, ports={ports}</default>
                <Required>Y</Required>
            </comment_template>
            <dry_run type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </dry_run>
            <precheck type="BooleanField">
                <default>1</default>
                <Required>Y</Required>
            </precheck>
            <precheck_min_confidence type="IntegerField">
                <MinimumValue>0</MinimumValue>
                <MaximumValue>100</MaximumValue>
                <default>25</default>
                <Required>Y</Required>
            </precheck_min_confidence>
        </reporter>
    </items>
</model>
